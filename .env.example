PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=your-prowlarr-api-key

TORBOX_API_KEY=your-torbox-api-key
TORBOX_BASE_URL=https://api.torbox.app/v1

RCLONE_REMOTE_NAME=torbox
RCLONE_CONFIG_PATH=./rclone.conf
LOCAL_STORAGE_PATH=./downloads

# Destination folders per media type (default to subfolders under downloads)
MOVIES_PATH=./downloads/movies
TV_PATH=./downloads/tv
OTHER_PATH=./downloads

AUTO_SYNC=false
POLL_INTERVAL_SECONDS=10
